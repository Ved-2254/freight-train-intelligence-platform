# Copy to backend/.env and adjust. Every variable is optional; defaults are shown.
# Relative paths are resolved against the backend/ directory.

# --- HTTP ---------------------------------------------------------------------------
FTIP_HOST=127.0.0.1                 # keep on localhost: the API has no authentication
FTIP_PORT=8000
FTIP_CORS_ORIGINS=http://localhost:3000   # comma-separated frontend origins; never "*"
# FTIP_PUBLIC_BASE_URL=http://localhost:8000   # set to return absolute links instead of /api/v1/...
FTIP_LOG_LEVEL=INFO

# --- Storage / database -------------------------------------------------------------
FTIP_STORAGE_ROOT=storage           # uploads/, jobs/<job_id>/outputs/, temporary/, app.db
# FTIP_DATABASE_PATH=storage/app.db
FTIP_MAX_UPLOAD_BYTES=2147483648    # 2 GiB
FTIP_ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv
FTIP_MIN_FREE_DISK_BYTES=1073741824 # refuse uploads/jobs below 1 GiB free (507)
FTIP_TEMPORARY_MAX_AGE_SECONDS=86400

# --- Pipeline -----------------------------------------------------------------------
# Model weights and all detection/tracking/counting settings come from this YAML file.
# FTIP_PIPELINE_CONFIG=configs/default.yaml

# --- Worker -------------------------------------------------------------------------
FTIP_START_EMBEDDED_WORKER=true     # API starts/supervises the worker (one command)
FTIP_WORKER_POLL_SECONDS=1.0
FTIP_HEARTBEAT_SECONDS=5
FTIP_STALE_JOB_SECONDS=60           # running job without heartbeat is considered interrupted
FTIP_MAX_ATTEMPTS=2                 # interrupted jobs are re-queued once
FTIP_PROGRESS_WRITE_INTERVAL=0.5
FTIP_CANCEL_CHECK_INTERVAL=0.5
